# PDF Translate engine settings
#
# MODEL_SOURCE picks where the model comes from:
#   public   the shared free endpoint (SiliconFlow Free); no Magpie, no API key
#   pinned   chosen in Magpie: the model Magpie's Agents page writes here
#   magpie   follow whatever model Magpie currently gives its agents
#
# The recommended setup is `pinned`: install the plugin in magpie-plugin/,
# then pick a model in Magpie > Agents > PDF Translate. Magpie writes MODEL,
# API_KEY and BASE_URL back into config.env, and a new key of its own.
#
# ENGINE=openaicompatible is the OpenAI-compatible path; MODEL_SOURCE decides
# whether that path points at Magpie's gateway or somewhere else.

ENGINE=openaicompatible
MODEL_SOURCE=pinned

# Written by Magpie when a model is picked there. Fill these in by hand only
# if you point the translator at a provider yourself.
API_KEY=
MODEL=
BASE_URL=

# Requests per second. Free endpoints need 5-10; your own paid key can take 32-64.
QPS=10
